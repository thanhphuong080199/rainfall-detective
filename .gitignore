# Godot 4+ specific ignores
.godot/
/android/

# NOTE: <asset>.import files are deliberately NOT ignored. Godot 4 stores each
# asset's import settings and its stable resource UID in them, so leaving them
# out of version control makes every clone re-import with fresh UIDs and
# default settings. Godot's own recommended ignore list is just .godot/ and
# /android/.

# Exception: localization/strings.csv is parsed at runtime by LocaleManager,
# not through Godot's import pipeline (see docs/localization.md) — but a
# local `godot --import` still auto-generates a default "Translation" import
# for it that nothing in the project references. Ignore that byproduct
# specifically, not .import files in general.
localization/strings.csv.import
localization/*.translation

# Editor/OS cruft
.DS_Store

# Claude Code session state (not project content) — except project skills,
# which are shared with everyone working on the repo.
.claude/*
!.claude/skills/
